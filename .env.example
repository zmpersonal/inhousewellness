# Copy to .env at repo root. .gitignore covers .env; never commit the real file.
# Paste the key directly -- editing this example file is how a placeholder
# ("sk-ant-your-key-here") once reached .env and failed with a 401.
# Do NOT put ANTHROPIC_BASE_URL here -- the SDK default endpoint is used deliberately.
ANTHROPIC_API_KEY=

# Required ONLY for identity-linked keys (sk-ant-api03-... issued against a user
# rather than a workspace). Without it the API returns:
#   400 anthropic-workspace-id is required when authenticating with an
#   identity-linked API key
# Find it in console.anthropic.com -> Settings -> Workspaces (id starts wrkspc_).
ANTHROPIC_WORKSPACE_ID=
