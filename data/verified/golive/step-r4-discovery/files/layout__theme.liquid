g-tag a{background-color:#c97b63;color:#2c3e50;padding:6px 14px;border-radius:20px;transition:.3s}#singleBlogPost .blog-tag a:hover{background-color:#2e4a3e;color:#fff}#singleBlogPost .list-social__link circle{stroke:#D9D9D9}#singleBlogPost .list-social__link:hover circle{fill:#C97B63}#singleBlogPost input,#singleBlogPost textarea{border:1px solid #d9d9d9}#singleBlogPost input:focus,#singleBlogPost textarea:focus{border-color:#2e4a3e;outline:0}#singleBlogPost,#singleBlogPost input,#singleBlogPost li,#singleBlogPost p,#singleBlogPost span,#singleBlogPost textarea{font-family:Inter,'Open Sans',system-ui,-apple-system,BlinkMacSystemFont,sans-serif}#singleBlogPost .article-template__title,#singleBlogPost h1,#singleBlogPost h2,#singleBlogPost h3,#singleBlogPost h4,#singleBlogPost h5,#singleBlogPost h6{font-family:'Playfair Display',Lora,serif;font-weight:600}#singleBlogPost .article-template__title{letter-spacing:.2px}#singleBlogPost .article_meta,#singleBlogPost .breadcrumb-list{font-family:Inter,'Open Sans',sans-serif}#singleBlogPost .btn-primary,#singleBlogPost button,#singleBlogPost input[type=submit]{font-family:Inter,'Open Sans',sans-serif;font-weight:600}.article-template__content ul{list-style:none;padding-left:1rem;margin-bottom:1.5rem}.article-template__content ul li{position:relative;padding-left:36px;margin-bottom:1.2rem;line-height:1.6}.article-template__content ul li::before{content:"✓";position:absolute;left:0;top:.2em;width:22px;height:22px;border-radius:50%;background-color:#2e4a3e;color:#fff;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}.blog-cta-button{display:inline-block;padding:14px 32px;background-color:#c97b63;color:#fff!important;border-radius:999px;font-family:Inter,sans-serif;font-weight:600;text-decoration:none;text-align:center}#singleBlogPost h1{font-weight:600}#singleBlogPost .caption,#singleBlogPost .meta{text-transform:uppercase;letter-spacing:.12em;font-size:11px}#singleBlogPost h2{margin-top:5rem}#singleBlogPost h3{margin-top:3rem}#singleBlogPost p{margin-bottom:2rem;line-height:1.85}
      </style>
    {% endif %}
    {% if template.name == 'product' %}
      {% for media in product.media %}
        {% if media.media_type == 'video' %}
          {% assign duration_seconds = media.duration | divided_by: 1000 %}
          {% assign duration_hours = duration_seconds | divided_by: 3600 %}
          {% assign duration_remaining = duration_seconds | modulo: 3600 %}
          {% assign duration_minutes = duration_remaining | divided_by: 60 %}
          {% assign duration_secs = duration_remaining | modulo: 60 %}
          {% assign mp4_source = media.sources | where: 'format', 'mp4' | first %}
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "VideoObject",
              "name": {{ product.title | json }},
              "description": {{ product.description | strip_html | truncatewords: 50 | json }},
              "thumbnailUrl": "https:{{ media.preview_image | image_url: width: 1280 }}",
              "uploadDate": "{{ product.created_at | date: '%Y-%m-%d' }}",
              "duration": "PT{{ duration_hours }}H{{ duration_minutes }}M{{ duration_secs }}S",
              "contentUrl": "https:{{ mp4_source.url }}",
              "embedUrl": "{{ shop.url }}{{ product.url }}",
              "publisher": {
                "@type": "Organization",
                "name": "{{ shop.name }}",
                "logo": {
                  "@type": "ImageObject",
                  "url": "https:{{ settings.logo | image_url: width: 600 }}"
                }
              },
              "potentialAction": {
                "@type": "SeekToAction",
                "target": "{{ shop.url }}{{ product.url }}?t={seek_to_second_number}",
                "startOffset-input": "required name=seek_to_second_number"
              },
              "interactionStatistic": {
                "@type": "InteractionCounter",
                "interactionType": {
                  "@type": "WatchAction"
                },
                "userInteractionCount": 1
              }
            }
          </script>
        {% endif %}
      {% endfor %}
    {% endif %}
  </body>
