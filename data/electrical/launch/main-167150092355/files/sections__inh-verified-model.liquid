{%- comment -%}
  INH Verified: one model page (templates/metaobject/sauna.json).

  Reads ONE thing: `metaobject.page_data`, a JSON field written by scripts/verified_pages.py
  from data/verified/saunas.json. The template only loops and prints; it never composes a
  value, never prints a price, and renders any record that meets the threshold without
  changes (a new record needs data, not template work).

  Order (Round 2 brief): H1, answer sentence, key facts, electrical, ask the seller, full
  specifications, similar models (brands INH does not sell), source text, Sources, cite this page,
  then, visually separated, the store band and the disclosure line. Models INH sells also get one
  compact store button directly under the key facts.
{%- endcomment -%}
{%- assign d = metaobject.page_data.value -%}
{{ 'inh-verified.css' | asset_url | stylesheet_tag }}
{%- if d -%}
<article class="inhv inhv-model" data-inhv="model" data-inh-id="{{ d.inh_id | escape }}">
  <nav class="inhv-crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="{{ d.hub_path }}">Sauna database</a></li>
      <li aria-current="page">{{ d.title | escape }}</li>
    </ol>
  </nav>

  <header class="inhv-head">
    <h1 class="inhv-h1">{{ d.title | escape }}</h1>
    {%- if d.model_number %}<p class="inhv-mn" data-inhv="model-number">Model {{ d.model_number | escape }}</p>{% endif %}
    <p class="inhv-answer" data-inhv="answer">{{ d.answer | escape }}</p>
    <p class="inhv-meta">Verified {{ d.verified_date }}<span aria-hidden="true"> · </span><a href="{{ d.methodology_path }}">How we verify these values</a></p>
  </header>

  <section class="inhv-block" aria-labelledby="inhv-key">
    <h2 id="inhv-key" class="inhv-h2">Key facts</h2>
    <dl class="inhv-facts" data-inhv="key-facts">
      {%- for f in d.key_facts %}{% render 'inh-verified-fact', f: f %}{% endfor -%}
    </dl>
  </section>

  {%- if d.store.sold %}
  <p class="inhv-store-top" data-inhv="store-top"><a class="btn btn-primary inhv-btn" href="{{ d.store.product_url }}">{{ d.store.product_label | escape }}</a></p>
  {%- endif %}

  <section class="inhv-block" aria-labelledby="inhv-elec">
    <h2 id="inhv-elec" class="inhv-h2">Electrical requirements</h2>
    <dl class="inhv-facts" data-inhv="electrical">
      {%- for f in d.electrical %}{% render 'inh-verified-fact', f: f %}{% endfor -%}
    </dl>
    <p class="inhv-small">Have a licensed electrician confirm the circuit before installation.</p>
  </section>

  {%- if d.ask_seller.size > 0 %}
  <section class="inhv-block inhv-ask" aria-labelledby="inhv-ask">
    <h2 id="inhv-ask" class="inhv-h2">Ask the seller</h2>
    <p class="inhv-small">The manufacturer's sources we read do not give a single verified answer to these. Ask before you buy:</p>
    <ul data-inhv="ask-seller">
      {%- for q in d.ask_seller %}<li data-field="{{ q.field | escape }}">{{ q.question | escape }}</li>{% endfor -%}
    </ul>
  </section>
  {%- endif %}

  <section class="inhv-block" aria-labelledby="inhv-specs">
    <h2 id="inhv-specs" class="inhv-h2">Full specifications</h2>
    <dl class="inhv-facts inhv-specs" data-inhv="specs">
      {%- for f in d.specs %}{% render 'inh-verified-fact', f: f %}{% endfor -%}
    </dl>
    {%- if d.spec_gaps.size > 0 %}
    <p class="inhv-gaps" data-inhv="spec-gaps"><span class="inhv-gaps-label">Not verified:</span>
      {%- for g in d.spec_gaps %} <span data-field="{{ g.field | escape }}" data-state="gap">{{ g.label | escape }}</span>{% unless forloop.last %},{% endunless %}{% endfor -%}
    </p>
    {%- endif %}
  </section>

  {%- if d.similar %}
  <section class="inhv-block inhv-similar" aria-labelledby="inhv-similar" data-inhv="similar">
    <h2 id="inhv-similar" class="inhv-h2">Similar models available at InHouse Wellness</h2>
    {%- if d.similar.items.size > 0 %}
    <p class="inhv-small">{{ d.similar.criteria | escape }}. Chosen by that rule alone, not a claim that they are equivalent: compare the specifications.</p>
    <ul>
      {%- for i in d.similar.items %}<li><a href="{{ i.url }}">{{ i.title | escape }}</a></li>{% endfor -%}
    </ul>
    {%- endif %}
    <p class="inhv-small"><a href="{{ d.similar.collection_url }}">{{ d.similar.collection_label | escape }}</a></p>
  </section>
  {%- endif %}

  {%- if d.snippets.size > 0 %}
  <details class="inhv-block inhv-quotes" data-inhv="source-text">
    <summary>Source text ({{ d.snippets.size }} quoted passages)</summary>
    <ul>
      {%- for s in d.snippets %}
      <li data-field="{{ s.field | escape }}"><q>{{ s.text | escape }}</q> <a class="inhv-fn" href="#inhv-src-{{ s.source_n }}" data-source-n="{{ s.source_n }}"><span aria-hidden="true">[{{ s.source_n }}]</span><span class="inhv-vh">Source {{ s.source_n }}</span></a></li>
      {%- endfor %}
    </ul>
  </details>
  {%- endif %}

  {%- if d.sources.size > 0 %}
  <section class="inhv-block inhv-sources" aria-labelledby="inhv-sources">
    <h2 id="inhv-sources" class="inhv-h2">Sources</h2>
    <ol class="inhv-srclist" data-inhv="sources">
      {%- for s in d.sources %}
      <li id="inhv-src-{{ s.n }}" data-source-n="{{ s.n }}" data-url="{{ s.url | escape }}"><a href="{{ s.url | escape }}" rel="nofollow noopener" target="_blank">{{ s.url | remove: 'https://' | remove: 'http://' | escape }}<span class="inhv-vh"> (opens in a new tab)</span></a> <span class="inhv-small">{{ s.grades | escape }} · fetched {{ s.fetched }}</span></li>
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}

  <section class="inhv-block inhv-cite" aria-labelledby="inhv-cite">
    <h2 id="inhv-cite" class="inhv-h2">Cite this page</h2>
    <p data-inhv="cite">{{ d.cite.text | escape }}</p>
    <p class="inhv-small">Found an error? Email <a href="mailto:{{ d.cite.corrections }}">{{ d.cite.corrections }}</a> with the source that shows the correct value.</p>
  </section>
</article>

<aside class="inhv inhv-store" aria-label="InHouse Wellness store" data-inhv="store">
  <p class="inhv-store-label">InHouse Wellness store</p>
  {%- if d.store.sold %}
  <p><a class="btn btn-primary inhv-btn" href="{{ d.store.product_url }}">{{ d.store.product_label | escape }}</a></p>
  {%- if d.store.collections.size > 0 %}
  <p class="inhv-small">In the store:
    {%- for c in d.store.collections %} <a href="{{ c.url }}">{{ c.title | escape }}</a>{% unless forloop.last %},{% endunless %}{% endfor -%}
  </p>
  {%- endif %}
  {%- else %}
  <p><a href="{{ d.store.manufacturer_url | escape }}" rel="nofollow noopener" target="_blank">Manufacturer's page for this model ({{ d.store.manufacturer_host | escape }})</a></p>
  <p><a class="btn btn-primary inhv-btn" href="{{ d.store.browse_url }}">{{ d.store.browse_label | escape }}</a></p>
  {%- endif %}
  <p class="inhv-disclosure">{{ d.disclosure | escape }} <a href="{{ d.methodology_path }}">How records are verified</a>.</p>
</aside>

{%- for ld in d.jsonld %}
<script type="application/ld+json">{{ ld | json }}</script>
{%- endfor %}
{%- endif -%}

{% schema %}
{
  "name": "INH Verified model",
  "settings": []
}
{% endschema %}
