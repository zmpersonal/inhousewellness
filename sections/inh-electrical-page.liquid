{%- comment -%}
  Electrical answer pages and the electrical methodology page (Round 1), via
  templates/page.inh-electrical-page.json.

  The body is the page's own content, server-rendered by scripts/electrical_build.py
  (data/electrical/pages/<handle>.html): every table is HTML, readable with JavaScript off, and
  every circuit cell quotes the manufacturer verbatim. This section adds only the frame:
  breadcrumb, H1, styles and structured data. It composes no value.

  STRUCTURED DATA, extends and never duplicates (the theme and Avada own BreadcrumbList,
  Organization, WebSite): answer pages emit FAQPage (one question: the page title; the answer: the
  body's first paragraph, which is the template-generated answer sentence) and a Dataset that
  isPartOf the database. The methodology page emits nothing new.
{%- endcomment -%}
{%- liquid
  assign is_method = false
  if page.handle == 'sauna-electrical-methodology'
    assign is_method = true
  endif
  assign answer = page.content | split: '</p>' | slice: 1 | first | strip_html | strip
-%}
{{ 'inh-verified.css' | asset_url | stylesheet_tag }}
{{ 'inh-electrical.css' | asset_url | stylesheet_tag }}
<article class="inhv inhe inhe-page" data-inhe="{% if is_method %}methodology{% else %}answer{% endif %}">
  <nav class="inhv-crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/pages/sauna-database">Sauna database</a></li>
      <li aria-current="page">{{ page.title | escape }}</li>
    </ol>
  </nav>
  <h1 class="inhv-h1">{{ page.title | escape }}</h1>
  <div class="inhe-body">{{ page.content }}</div>
</article>
{%- unless is_method or inhe_page_schema_done -%}
{%- assign inhe_page_schema_done = true -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": {{ page.title | json }},
    "acceptedAnswer": {"@type": "Answer", "text": {{ answer | json }}}
  }]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": {{ page.title | append: ' (InHouse Wellness Verified Sauna Database)' | json }},
  "description": {{ answer | json }},
  "url": {{ shop.url | append: page.url | json }},
  "isPartOf": {"@type": "Dataset", "name": "InHouse Wellness Verified Sauna Database", "url": {{ shop.url | append: '/pages/sauna-database' | json }}},
  "creator": {"@type": "Organization", "name": "InHouse Wellness", "url": {{ shop.url | json }}},
  "isAccessibleForFree": true,
  "variableMeasured": ["Manufacturer-stated circuit", "Heater power", "Supply voltage", "Dedicated circuit"]
}
</script>
{%- endunless -%}

{% schema %}
{
  "name": "INH electrical page",
  "settings": []
}
{% endschema %}
