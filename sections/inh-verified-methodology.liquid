{%- comment -%}
  INH Verified: the methodology page (templates/page.inh-verified-methodology.json).
  The body is the page's own content, generated by scripts/verified_pages.py from the
  dataset (counts) and CLAUDE.md (the editorial-independence clause, verbatim). The
  section adds only the frame, so no count is ever typed into a template.
{%- endcomment -%}
{{ 'inh-verified.css' | asset_url | stylesheet_tag }}
<article class="inhv inhv-method" data-inhv="methodology">
  <nav class="inhv-crumbs" aria-label="Breadcrumb">
    <ol><li><a href="/">Home</a></li><li><a href="/pages/sauna-database">Sauna database</a></li><li aria-current="page">{{ page.title | escape }}</li></ol>
  </nav>
  <header class="inhv-head"><h1 class="inhv-h1">{{ page.title | escape }}</h1></header>
  <div class="inhv-prose">{{ page.content }}</div>
</article>
<script type="application/ld+json">
{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }}},
  {"@type": "ListItem", "position": 2, "name": "Sauna database", "item": {{ shop.url | append: '/pages/sauna-database' | json }}},
  {"@type": "ListItem", "position": 3, "name": {{ page.title | json }}, "item": {{ shop.url | append: '/pages/sauna-database-methodology' | json }}}]}
</script>

{% schema %}
{
  "name": "INH Verified methodology",
  "settings": []
}
{% endschema %}
