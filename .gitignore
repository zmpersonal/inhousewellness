.DS_Store
# state/ is TRACKED on purpose. The counter and the published log are the
# audit trail for the 14-day gate, and CI commits them back after each run.
# They contain no secrets. Renders and reels stay ignored.
state/*.tmp
.env
# Secrets — never commit
.env
.env.*
!.env.example
.env.txt

# Link building — SQLite working DB is a build artifact, rebuilt from schema.sql
linkbuilding/data/links.db
