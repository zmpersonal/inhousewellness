.DS_Store
# state/ is TRACKED on purpose. The counter and the published log are the
# audit trail for the 14-day gate, and CI commits them back after each run.
# They contain no secrets. Renders and reels stay ignored.
state/*.tmp
.env
# Secrets — never commit
.env
.env.*
!.env.example
.env.txt

# Generated by scripts/preview_true_total_cost.py from sections/ + templates/.
# Regenerate rather than edit; a committed copy would drift from its source.
preview/true-total-cost/
